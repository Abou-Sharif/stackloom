<% if (options.architecture === 'lightweight') { -%>
<% const _refPopulate = resource.fields.filter(function(f) { return f.type === 'ref' || f.type === 'reference'; }); -%>
// Lightweight architecture — CRUD logic lives inline here; no separate service layer.
const <%= resource.pascalName %> = require('../models/<%= resource.name %>');
const ApiResponse = require('../../../utils/ApiResponse');
const ApiError = require('../../../utils/ApiError');

// ── Create ───────────────────────────────────────────────────────────────────
const create = async (req, res, next) => {
  try {
<% if (resource.features && resource.features.auditLog) { -%>
    req.body.createdBy = req.user?._id;
<% } -%>
    const result = await <%= resource.pascalName %>.create(req.body);
    return res.status(201).json(new ApiResponse(201, '<%= resource.pascalName %> created', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

<% if (options.crud !== 'insert-only') { -%>
// ── List (paginated) ─────────────────────────────────────────────────────────
const list = async (req, res, next) => {
  try {
    const page = parseInt(req.query.page, 10) || 1;
    const limit = parseInt(req.query.limit, 10) || 20;
    let query = <%= resource.pascalName %>.find()
      .sort({ [req.query.sort || 'createdAt']: req.query.order === 'asc' ? 1 : -1 })
      .skip((page - 1) * limit)
      .limit(limit);
<% if (_refPopulate.length) { -%>
    // Populate ref fields by default so the API always returns resolved objects.
    // Pass ?populate=false to suppress, or ?populate=field1,field2 for specific fields.
    if (req.query.populate === 'false') {
      // skip population
    } else if (req.query.populate && req.query.populate !== 'true') {
      req.query.populate.split(',').forEach(f => query = query.populate(f.trim()));
    } else {
      <%- JSON.stringify(_refPopulate.map(function(f) { return f.name; })) %>.forEach(f => query = query.populate(f));
    }
<% } -%>
    const [data, total] = await Promise.all([
      query.lean(),
      <%= resource.pascalName %>.countDocuments(),
    ]);
    return res.status(200).json(
      new ApiResponse(200, 'Fetched', { data, total, page, limit, pages: Math.ceil(total / limit) }).body,
    );
  } catch (err) {
    return next(err);
  }
};

// ── Get One ──────────────────────────────────────────────────────────────────
const getOne = async (req, res, next) => {
  try {
    let query = <%= resource.pascalName %>.findById(req.params.id);
<% if (_refPopulate.length) { -%>
    query = query.populate(<%- JSON.stringify(_refPopulate.map(function(f) { return f.name; })) %>);
<% } -%>
<% if (resource.relations && resource.relations.hasMany && resource.relations.hasMany.length > 0) { -%>
    // Populate hasMany virtuals (e.g. Customer → orders)
<% resource.relations.hasMany.forEach(function(rel) { -%>
    query = query.populate('<%- rel.field %>');
<% }); -%>
<% } -%>
    const result = await query;
    if (!result) throw new ApiError(404, '<%= resource.pascalName %> not found');
    return res.status(200).json(new ApiResponse(200, 'Fetched', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

// ── Update ───────────────────────────────────────────────────────────────────
const update = async (req, res, next) => {
  try {
<% if (resource.features && resource.features.auditLog) { -%>
    req.body.updatedBy = req.user?._id;
<% } -%>
    let result = await <%= resource.pascalName %>.findByIdAndUpdate(req.params.id, req.body, {
      new: true,
      runValidators: true,
    });
    if (!result) throw new ApiError(404, '<%= resource.pascalName %> not found');
<% if (_refPopulate.length) { -%>
    result = await result.populate(<%- JSON.stringify(_refPopulate.map(function(f) { return f.name; })) %>);
<% } -%>
    return res.status(200).json(new ApiResponse(200, 'Updated', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

// ── Delete ───────────────────────────────────────────────────────────────────
const remove = async (req, res, next) => {
  try {
    const result = await <%= resource.pascalName %>.findByIdAndDelete(req.params.id);
    if (!result) throw new ApiError(404, '<%= resource.pascalName %> not found');
    return res.status(200).json(new ApiResponse(200, 'Deleted').body);
  } catch (err) {
    return next(err);
  }
};
<% } -%>

<% if (options.crud !== 'insert-only') { -%>
module.exports = { create, list, getOne, update, remove };
<% } else { -%>
module.exports = { create };
<% } -%>
<% } else { -%>
<% const _refPopulate = resource.fields.filter(function(f) { return f.type === 'ref' || f.type === 'reference'; }); -%>
// Layered architecture — the controller is thin; domain logic lives in the service.
const service = require('../services/<%= resource.name %>.service');
const ApiResponse = require('../../../utils/ApiResponse');

// ── Create ───────────────────────────────────────────────────────────────────
const create = async (req, res, next) => {
  try {
<% if (resource.features && resource.features.auditLog) { -%>
    req.body.createdBy = req.user?._id;
<% } -%>
    const result = await service.create<%= resource.pascalName %>(req.body);
    return res.status(201).json(new ApiResponse(201, '<%= resource.pascalName %> created', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

<% if (options.crud !== 'insert-only') { -%>
// ── List (with pagination, filtering, sorting) ───────────────────────────────
const list = async (req, res, next) => {
  try {
    const { page = 1, limit = 20, sort = 'createdAt', order = 'desc' } = req.query;
    const filters = {
      page: parseInt(page, 10),
      limit: parseInt(limit, 10),
      sort,
      order,
<% resource.fields.forEach(function(f) { -%>
      <%= f.name %>: req.query.<%= f.name %>,
<% }); -%>
      populate: req.query.populate ? req.query.populate.split(',') : [],
    };
    const result = await service.getAll<%= resource.pluralPascal %>(filters);
    return res.status(200).json(new ApiResponse(200, 'Fetched', result).body);
  } catch (err) {
    return next(err);
  }
};

// ── Get One ──────────────────────────────────────────────────────────────────
const getOne = async (req, res, next) => {
  try {
    const result = await service.get<%= resource.pascalName %>ById(req.params.id);
    return res.status(200).json(new ApiResponse(200, 'Fetched', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

// ── Update ───────────────────────────────────────────────────────────────────
const update = async (req, res, next) => {
  try {
<% if (resource.features && resource.features.auditLog) { -%>
    req.body.updatedBy = req.user?._id;
<% } -%>
    const result = await service.update<%= resource.pascalName %>(req.params.id, req.body);
    return res.status(200).json(new ApiResponse(200, 'Updated', { data: result }).body);
  } catch (err) {
    return next(err);
  }
};

// ── Delete ───────────────────────────────────────────────────────────────────
const remove = async (req, res, next) => {
  try {
    await service.delete<%= resource.pascalName %>(req.params.id);
    return res.status(200).json(new ApiResponse(200, 'Deleted').body);
  } catch (err) {
    return next(err);
  }
};
<% } -%>

<% if (options.crud !== 'insert-only') { -%>
module.exports = { create, list, getOne, update, remove };
<% } else { -%>
module.exports = { create };
<% } -%>
<% } -%>
