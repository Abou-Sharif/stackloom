const <%= resource.pascalName %> = require('../models/<%= resource.name %>');

const create = async (req, res, next) => {
  try {
    const result = await <%= resource.pascalName %>.create(req.body);
    res.status(201).json(result);
  } catch (err) { next(err); }
};

<% if (options.crud !== 'insert-only') { -%>
const list = async (req, res, next) => {
  try {
    const results = await <%= resource.pascalName %>.find().sort('-createdAt');
    res.json(results);
  } catch (err) { next(err); }
};

const getOne = async (req, res, next) => {
  try {
    const result = await <%= resource.pascalName %>.findById(req.params.id);
    if (!result) return res.status(404).json({ error: '<%= resource.pascalName %> not found' });
    res.json(result);
  } catch (err) { next(err); }
};

const update = async (req, res, next) => {
  try {
    const result = await <%= resource.pascalName %>.findByIdAndUpdate(req.params.id, req.body, { new: true, runValidators: true });
    if (!result) return res.status(404).json({ error: '<%= resource.pascalName %> not found' });
    res.json(result);
  } catch (err) { next(err); }
};

const remove = async (req, res, next) => {
  try {
    const result = await <%= resource.pascalName %>.findByIdAndDelete(req.params.id);
    if (!result) return res.status(404).json({ error: '<%= resource.pascalName %> not found' });
    res.json({ message: 'Deleted' });
  } catch (err) { next(err); }
};
<% } -%>

<% if (options.crud !== 'insert-only') { -%>
module.exports = { create, list, getOne, update, remove };
<% } else { -%>
module.exports = { create };
<% } -%>
