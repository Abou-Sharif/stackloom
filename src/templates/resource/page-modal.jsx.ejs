import React, { useState } from 'react';
import { use<%= resource.pascalName %> } from "@/hooks/use<%= resource.pascalName %>";
import { <%= resource.pascalName %>Table } from "@/components/tables/<%= resource.pascalName %>Table";
import { <%= resource.pascalName %>Form } from "@/components/forms/<%= resource.pascalName %>Form";
import { Button } from "@/components/ui/button";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogDescription,
} from "@/components/ui/dialog";
import { Plus, RefreshCcw, Inbox } from "lucide-react";
import { PageWrapper } from "@/components/layout/PageWrapper";
import api from "@/api/<%= resource.kebabName %>.api";
import { toast } from "sonner";

function SkeletonRow() {
  return (
    <tr className="animate-pulse">
      <% resource.fields.forEach(function(f) { %>
      <td className="p-3"><div className="h-4 w-3/4 rounded bg-muted" /></td>
      <% }); %>
      <td className="p-3"><div className="h-8 w-20 rounded bg-muted" /></td>
    </tr>
  );
}

function EmptyState() {
  return (
    <div className="flex flex-col items-center justify-center py-16 text-center" role="status">
      <Inbox className="mb-4 h-12 w-12 text-muted-foreground/50" />
      <p className="text-lg font-medium text-muted-foreground">No <%= resource.pluralPascal.toLowerCase() %> found</p>
      <p className="mt-1 text-sm text-muted-foreground/70">Get started by creating your first <%= resource.name.toLowerCase() %>.</p>
    </div>
  );
}

// form-mode: modal — create/edit form is mounted inside a Dialog.
export default function <%= resource.pascalName %>ListPage() {
  const { data, loading, refresh } = use<%= resource.pascalName %>();
  const [formOpen, setFormOpen] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  const [serverErrors, setServerErrors] = useState(null);

  const handleCreate = () => {
    setEditingItem(null);
    setServerErrors(null);
    setFormOpen(true);
  };

  const handleEdit = (item) => {
    setEditingItem(item);
    setServerErrors(null);
    setFormOpen(true);
  };

  const handleDelete = async (item) => {
    if (!confirm("Are you sure you want to delete this <%= resource.name.toLowerCase() %>?")) return;
    try {
      await api.delete(item._id);
      toast.success("<%= resource.name %> deleted successfully");
      refresh();
    } catch (err) {
      const msg = err.response?.data?.message || "Failed to delete";
      toast.error(msg);
    }
  };

  const handleSubmit = async (formData) => {
    setServerErrors(null);
    try {
      if (editingItem) {
        await api.update(editingItem._id, formData);
        toast.success("<%= resource.name %> updated successfully");
      } else {
        await api.create(formData);
        toast.success("<%= resource.name %> created successfully");
      }
      setFormOpen(false);
      refresh();
    } catch (err) {
      const responseErrors = err.response?.data?.errors;
      if (responseErrors && Array.isArray(responseErrors) && responseErrors.length > 0) {
        const mapped = {};
        responseErrors.forEach((e) => { mapped[e.field] = e.message; });
        setServerErrors(mapped);
      }
      const msg = err.response?.data?.message || "Something went wrong";
      toast.error(msg);
    }
  };

  return (
    <PageWrapper
      title="<%= resource.pluralPascal %>"
      subtitle="Manage your <%= resource.pluralPascal.toLowerCase() %>"
      actions={
        <div className="flex gap-2">
          <Button variant="outline" size="icon" onClick={() => refresh()} disabled={loading} aria-label="Refresh list">
            <RefreshCcw className={`h-4 w-4 ${loading ? 'animate-spin' : ''}`} />
          </Button>
          <Button onClick={handleCreate}>
            <Plus className="mr-2 h-4 w-4" /> Add <%= resource.name %>
          </Button>
        </div>
      }
    >
      <div className="space-y-4">
        {loading ? (
          <table className="w-full">
            <tbody>
              <SkeletonRow /><SkeletonRow /><SkeletonRow />
            </tbody>
          </table>
        ) : data && data.length > 0 ? (
          <<%= resource.pascalName %>Table data={data} onEdit={handleEdit} onDelete={handleDelete} />
        ) : (
          <EmptyState />
        )}
      </div>

      <Dialog open={formOpen} onOpenChange={setFormOpen}>
        <DialogContent className="max-w-2xl max-h-[90vh] overflow-y-auto">
          <DialogHeader>
            <DialogTitle>{editingItem ? "Edit <%= resource.name %>" : "Create <%= resource.name %>"}</DialogTitle>
            <DialogDescription>
              {editingItem ? "Update the details below." : "Fill in the details to create a new <%= resource.name.toLowerCase() %>."}
            </DialogDescription>
          </DialogHeader>
          <<%= resource.pascalName %>Form
            key={editingItem?._id || 'create'}
            initialData={editingItem}
            onSubmit={handleSubmit}
            onCancel={() => setFormOpen(false)}
            isLoading={loading}
            serverErrors={serverErrors}
          />
        </DialogContent>
      </Dialog>
    </PageWrapper>
  );
}
