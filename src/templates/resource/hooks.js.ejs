import { useState, useEffect, useCallback, useRef } from 'react';
import api from '../api/<%= resource.kebabName %>.api';

/**
 * use<%= resource.pascalName %> hook
 * Handles data fetching and state for <%= resource.name %> resource
 */
export const use<%= resource.pascalName %> = (id = null) => {
  const [data, setData] = useState(id ? null : []);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const paramsRef = useRef({});

  const refresh = useCallback(() => {
    let cancelled = false;
    const fetch = async () => {
      setLoading(true);
      setError(null);
      try {
        if (id) {
          const result = await api.getById(id);
          if (!cancelled) setData(result?.data ?? result);
        } else {
          const result = await api.getAll(paramsRef.current);
          if (!cancelled) {
            setData(Array.isArray(result) ? result : (result?.data ?? []));
          }
        }
      } catch (err) {
        if (!cancelled) setError(err);
      } finally {
        if (!cancelled) setLoading(false);
      }
    };
    fetch();
    return () => { cancelled = true; };
  }, [id]);

  useEffect(() => {
    const cleanup = refresh();
    return cleanup;
  }, [refresh]);

  const setParams = useCallback((params) => {
    paramsRef.current = params;
  }, []);

  return { data, loading, error, refresh, setParams };
};
