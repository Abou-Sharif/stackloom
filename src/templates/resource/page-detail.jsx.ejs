import React from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { use<%= resource.pascalName %> } from "@/hooks/use<%= resource.pascalName %>";
import { Button } from "@/components/ui/button";
import { ArrowLeft, Edit } from "lucide-react";
import { PageWrapper } from "@/components/layout/PageWrapper";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

function DetailSkeleton() {
  return (
    <div className="animate-pulse space-y-4" role="status" aria-label="Loading">
      <div className="grid gap-4 md:grid-cols-2">
        <Card>
          <CardHeader><div className="h-6 w-1/3 rounded bg-muted" /></CardHeader>
          <CardContent className="space-y-3">
            <% resource.fields.forEach(function(f) { %>
            <div className="flex justify-between border-b pb-2">
              <div className="h-4 w-1/4 rounded bg-muted" />
              <div className="h-4 w-1/3 rounded bg-muted" />
            </div>
            <% }); %>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}

export default function <%= resource.pascalName %>DetailPage() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { data: item, loading, error } = use<%= resource.pascalName %>(id);

  if (loading) return <DetailSkeleton />;
  if (error) return <div role="alert">Error loading <%= resource.name.toLowerCase() %>: {error.message}</div>;
  if (!item) return <div role="status"><%= resource.name %> not found</div>;

  return (
    <PageWrapper 
      title={`<%= resource.name %> Details`}
      actions={
        <div className="flex gap-2">
          <Button variant="outline" onClick={() => navigate(-1)} aria-label="Go back">
            <ArrowLeft className="mr-2 h-4 w-4" /> Back
          </Button>
          <Button onClick={() => navigate(`/admin/<%= resource.pluralKebab %>/edit/${id}`)} aria-label="Edit <%= resource.name.toLowerCase() %>">
            <Edit className="mr-2 h-4 w-4" /> Edit
          </Button>
        </div>
      }
    >
      <div className="grid gap-4 md:grid-cols-2">
        <Card>
          <CardHeader>
            <CardTitle>Information</CardTitle>
          </CardHeader>
           <CardContent className="space-y-2">
             <% resource.fields.forEach(function(field) { %>
             <div className="flex justify-between border-b pb-2">
               <span className="font-medium text-muted-foreground"><%- field.name.charAt(0).toUpperCase() + field.name.slice(1) %></span>
                <span>{<% if (field.type === 'boolean') { %>
                  item.<%- field.name %> ? 'Yes' : 'No'
                <% } else if (field.type === 'date' || field.type === 'datetime') { %>
                  new Date(item.<%- field.name %>).toLocaleString()
                <% } else if (field.type === 'ref' || field.type === 'reference') { %>
                  typeof item.<%- field.name %> === 'object' ? (item.<%- field.name %>.name || item.<%- field.name %>.title || item.<%- field.name %>.code || item.<%- field.name %>.email || item.<%- field.name %>._id) : (item.<%- field.name %> ? String(item.<%- field.name %>).slice(0, 8) + '…' : '—')
                <% } else { %>
                  item.<%- field.name %>
                <% } %>}</span>
              </div>
              <% }); %>
           </CardContent>
        </Card>
      </div>
    </PageWrapper>
  );
}
