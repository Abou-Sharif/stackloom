{
  "name": "stackloom",
  "version": "0.1.0",
  "description": "Stackloom — weave production-ready full-stack apps. Recipe-driven, transactional code generation for MERN and beyond.",
  "type": "module",
  "bin": {
    "loom": "./bin/cli.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "dev": "node --watch bin/cli.js",
    "start": "node bin/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "vitest run"
  },
  "keywords": [
    "stackloom",
    "loom",
    "mern",
    "scaffold",
    "generator",
    "cli",
    "react",
    "express",
    "mongodb",
    "starter",
    "fullstack"
  ],
  "author": "Benimana Flaubert <jean21101999@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BENIMANA-II/stackloom.git"
  },
  "homepage": "https://github.com/BENIMANA-II/stackloom#readme",
  "bugs": {
    "url": "https://github.com/BENIMANA-II/stackloom/issues"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "ejs": "^5.0.2",
    "fs-extra": "^11.3.0",
    "inquirer": "^13.3.2",
    "ora": "^8.0.1",
    "tar": "^7.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin",
    "src",
    "branding.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.7.0",
    "@types/tar": "^7.0.87",
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
